FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 NOVAOPS_MCP_HOST=0.0.0.0
WORKDIR /app
RUN addgroup --system novaops && adduser --system --ingroup novaops novaops
COPY . .
RUN python -m pip install --no-cache-dir .
RUN mkdir -p /data && chown -R novaops:novaops /app /data
USER novaops
EXPOSE 9880
HEALTHCHECK --interval=30s --timeout=3s --start-period=10s --retries=3 \
  CMD python -c "import socket; s=socket.create_connection(('127.0.0.1',9880),2); s.close()"
CMD ["python", "retrieval_mcp_server.py"]
