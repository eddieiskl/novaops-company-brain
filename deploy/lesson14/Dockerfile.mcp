FROM python:3.12-slim
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 PYTHON_DOTENV_DISABLED=1 NOVAOPS_MCP_HOST=0.0.0.0
WORKDIR /app
RUN groupadd --gid 10001 novaops && useradd --uid 10001 --gid 10001 --create-home novaops
COPY deploy/lesson14/requirements-mcp.txt /tmp/requirements.txt
RUN pip install --no-cache-dir -r /tmp/requirements.txt
COPY model_client.py retrieval_mcp_server.py ./
COPY company_brain/ ./company_brain/
COPY maya/ ./maya/
COPY webex/ ./webex/
COPY novaops-enterprise-agent-dataset/ ./novaops-enterprise-agent-dataset/
RUN mkdir /data && chown novaops:novaops /data
USER novaops
EXPOSE 9880
HEALTHCHECK --interval=10s --timeout=6s --start-period=15s --retries=9 CMD python -c "from company_brain.mcp_client import MCPToolClient; assert MCPToolClient('http://127.0.0.1:9880/mcp').discover_sync()"
CMD ["python","retrieval_mcp_server.py"]
