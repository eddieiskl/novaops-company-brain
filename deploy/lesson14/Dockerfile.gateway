FROM python:3.12-slim
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1
RUN pip install --no-cache-dir "litellm[proxy]==1.101.0" && groupadd --gid 10001 novaops && useradd --uid 10001 --gid 10001 --create-home novaops
WORKDIR /app
COPY deploy/lesson14/gateway.yaml ./config.yaml
USER novaops
EXPOSE 4000
HEALTHCHECK --interval=10s --timeout=5s --start-period=50s --retries=9 CMD python -c "import urllib.request; urllib.request.urlopen('http://127.0.0.1:4000/health/liveliness',timeout=3)"
CMD ["litellm","--config","/app/config.yaml","--host","0.0.0.0","--port","4000"]
