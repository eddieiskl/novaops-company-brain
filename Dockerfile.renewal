FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1
WORKDIR /app
RUN addgroup --system novaops && adduser --system --ingroup novaops novaops
COPY . .
RUN python -m pip install --no-cache-dir .
RUN mkdir -p /data && chown -R novaops:novaops /app /data
USER novaops
HEALTHCHECK --interval=30s --timeout=3s --start-period=10s --retries=3 \
  CMD ["python", "-m", "renewal.worker", "health"]
CMD ["python", "-m", "renewal.worker", "serve"]
